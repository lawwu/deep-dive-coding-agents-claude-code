    {
      "id": "pDaZNQlvU5-Ai4ofpmMTN",
      "type": "text",
      "x": -945.0611568186544,
      "y": 1339.3249655857012,
      "width": 1477.6352864734622,
      "height": 428.4618750000004,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
